# Google Apps Script Web App URL (deployed once via Apps Script).
# Copy after deploying the backend in apps-script/ as a Web App.
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# Shared secret between Next.js and Apps Script.
# Must match the APPS_SCRIPT_SECRET script property on the Apps Script project.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPS_SCRIPT_SECRET=replace-with-a-long-random-secret

# Second Apps Script credential, sent on every upstream request alongside
# APPS_SCRIPT_SECRET. Must match the ADMIN_SERVICE_KEY script property.
# The web app is deployed ANYONE_ANONYMOUS, so its URL alone must never be
# enough to read or write the spreadsheet. Minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SERVICE_KEY=replace-with-a-long-random-service-key

# Staff PIN for /login. Exactly 8 digits.
# Stored as-is rather than hashed: an 8-digit space is small enough to
# brute-force offline, so a hash would not help. Protection comes from the
# constant-time compare in lib/auth/pin.ts plus the login throttle.
ADMIN_PIN=00000000

# Signs the admin session cookie. Minimum 32 characters.
# Rotating this invalidates every outstanding session immediately, which is
# the way to recover from a suspected leak. Never sent to Apps Script.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-signing-secret

# Set to "off" to disable the in-process Apps Script read cache.
# Useful when debugging freshness; leave unset in production.
# APPS_SCRIPT_CACHE=off

# Neon Postgres (primary data store for students, events, attendance, organizers).
# Localhost must point at a dev branch, never production.
# Copy from Neon dashboard: Branches -> dev -> Connect.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Per-domain Neon cutover flags (each neon|script, default script).
# Flip a domain to neon only after its import + verification (§7).
# NEON_STUDENTS=script
# NEON_EVENTS=script
# NEON_ATTENDANCE=script
# NEON_ORGANIZATIONS=script

# Shared secret for the nightly Sheets-backup cron (GET /api/admin/backup).
# Vercel cron sends it as `Authorization: Bearer <secret>`. An unset secret
# fails closed: the endpoint always answers 401.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace-with-a-long-random-cron-secret
