# Google Apps Script Web App URL (deployed once via Apps Script).
# Copy after deploying the backend in apps-script/ as a Web App.
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# Shared secret between Next.js and Apps Script.
# Must match the APPS_SCRIPT_SECRET script property on the Apps Script project.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPS_SCRIPT_SECRET=replace-with-a-long-random-secret